# Copy this file to backend/.env
# Never commit backend/.env

DATABASE_URL=postgresql+asyncpg://lenny:lenny@127.0.0.1:5433/lenny

# ollama or openai
LLM_PROVIDER=ollama
CHAT_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required only if you use the OpenAI toggle in the UI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT_SECONDS=120
